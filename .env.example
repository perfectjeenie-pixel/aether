# Example environment variables

# Next.js / Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_web_push_vapid_public_key
NEXT_PUBLIC_THEME_COLOR=#6C5CE7

# Supabase (client-facing)
NEXT_PUBLIC_SUPABASE_URL=https://xyz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Backend (server-side)
API_PORT=4000
DATABASE_URL=postgresql://user:pass@localhost:5432/aether
STORAGE_URL=http://localhost:9000
STORAGE_BUCKET=aether-media
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me

# Supabase service role key (server only, keep secret)
SUPABASE_SERVICE_ROLE_KEY=service-role-key
SUPABASE_URL=https://xyz.supabase.co

# Firebase (Android)
FCM_SERVER_KEY=your_firebase_server_key

# Note: Do NOT store private keys or user secrets in plaintext in repos.
# For Vercel set the NEXT_PUBLIC_* vars and SUPABASE_SERVICE_ROLE_KEY in project settings.
